[Unit]
Description=TradeAI Streamlit Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/TRADEAI
ExecStart=/usr/bin/python3 -m streamlit run app.py --server.address=0.0.0.0 --server.port=8501 --server.headless=true
Restart=on-failure
RestartSec=15

StandardOutput=append:/home/admin/TRADEAI/streamlit.log
StandardError=append:/home/admin/TRADEAI/streamlit.log

[Install]
WantedBy=multi-user.target
